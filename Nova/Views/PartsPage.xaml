<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Nova.Views.PartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nova.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="#121217"
        Padding="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Parts"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                <TextBlock
                    Text="Manage part information, companies, and pricing"
                    Margin="0,4,0,0"
                    Foreground="#9E9EA8"/>

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="New Part"
                Padding="18,9"
                VerticalAlignment="Center"
                Background="#7659B0"
                Foreground="White"
                Click="NewPart_Click"/>

        </Grid>


        <!-- SEARCH -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBox
                    x:Name="PartSearchBar"
                    PlaceholderText="Search parts..."
                    Style="{StaticResource NovaTextBoxStyle}"
                    TextChanged="PartSearchBar_TextChanged"/>

                <ListView
                    x:Name="PartSearchResults"
                    MaxHeight="180"
                    Margin="0,4,0,0"
                    SelectionChanged="PartSearchResult_SelectionChanged"/>

            </StackPanel>

        </Grid>


        <!-- MAIN CONTENT -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>


            <!-- PART INFORMATION -->
            <Border
                Grid.Column="0"
                Background="#1F1F24"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TITLE -->
                    <TextBlock
                        Grid.Row="0"
                        Text="Part Information"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#C8B3FF"
                        Margin="0,0,0,16"/>


                    <!-- NAME + PRIMARY NUMBER -->
                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- PART NAME -->
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock FontSize="14">

                                <Run Text="Part Name"/>

                                <Run
                                    Text=" *"
                                    Foreground="Red"/>

                            </TextBlock>

                            <TextBox
                                x:Name="PartNameText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PRIMARY PART NUMBER -->
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock FontSize="14">

                                <Run Text="Primary Part Number"/>

                                <Run
                                    Text=" *"
                                    Foreground="Red"/>

                            </TextBlock>

                            <TextBox
                                x:Name="PrimaryPartNumberText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- UNIT TYPE + SHIP WEIGHT -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="12"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- UNIT TYPE -->
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock FontSize="14">

                                <Run Text="Unit Type"/>

                                <Run
                                    Text=" *"
                                    Foreground="Red"/>

                            </TextBlock>

                            <TextBox
                                x:Name="UnitTypeText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>


                        <!-- SHIP WEIGHT -->
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock FontSize="14">

                                <Run Text="Ship Weight"/>

                                <Run
                                    Text=" *"
                                    Foreground="Red"/>

                            </TextBlock>

                            <TextBox
                                x:Name="ShipWeightText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- CUBIC FEET + FLAGS -->
                    <Grid
                        Grid.Row="3"
                        ColumnSpacing="12"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- CUBIC FEET -->
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock FontSize="14">

                                <Run Text="Cubic Feet"/>

                                <Run
                                    Text=" *"
                                    Foreground="Red"/>

                            </TextBlock>

                            <TextBox
                                x:Name="CubicFeetText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>


                        <!-- PART FLAGS -->
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Part Flags"
                                FontSize="14"/>

                            <Border
                                Background="#17171B"
                                BorderBrush="#4E426F"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">

                                <StackPanel>

                                    <CheckBox
                                        x:Name="DrawingOnFileCheckBox"
                                        Content="Drawing on File"
                                        HorizontalAlignment="Left"/>

                                    <CheckBox
                                        x:Name="MoldAvailableCheckBox"
                                        Content="Mold Available"
                                        HorizontalAlignment="Left"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>


                    <!-- DESCRIPTION -->
                    <StackPanel
                        Grid.Row="4"
                        Spacing="4"
                        Margin="0,0,0,12">

                        <TextBlock
                            Text="Description"
                            FontSize="14"/>

                        <TextBox
                            x:Name="DescriptionText"
                            Style="{StaticResource NovaTextBoxStyle}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="70"
                            VerticalContentAlignment="Top"/>

                    </StackPanel>


                    <!-- DIVIDER -->
                    <Rectangle
                        Grid.Row="5"
                        Height="1"
                        Fill="#3C3548"
                        Margin="0,4,0,16"/>


                    <!-- NOTES -->
                    <StackPanel
                        Grid.Row="6"
                        Spacing="4">

                        <TextBlock
                            Text="Notes"
                            FontSize="14"/>

                        <TextBox
                            x:Name="NotesText"
                            Style="{StaticResource NovaTextBoxStyle}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="110"
                            VerticalContentAlignment="Top"/>

                    </StackPanel>


                    <!-- SAVE -->
                    <Button
                        Grid.Row="7"
                        Content="Save Part"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        Padding="18,9"
                        Background="#7659B0"
                        Foreground="White"
                        Click="SavePart_Click"/>

                </Grid>

            </Border>


            <!-- RELATED COMPANIES -->
            <Border
                Grid.Column="1"
                Background="#211D29"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TITLE -->
                    <TextBlock
                        Grid.Row="0"
                        Text="Related Companies"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#D2C1FF"
                        Margin="0,0,0,14"/>


                    <!-- SEARCH -->
                    <TextBox
                        Grid.Row="1"
                        x:Name="CompanySearchBar"
                        PlaceholderText="Search companies..."
                        Style="{StaticResource NovaTextBoxStyle}"
                        TextChanged="CompanySearchBar_TextChanged"
                        Margin="0,0,0,8"/>


                    <!-- COMPANY LIST -->
                    <ListView
                        Grid.Row="2"
                        x:Name="CompanyList"
                        MinHeight="130"
                        MaxHeight="200"
                        SelectionChanged="CompanyList_SelectionChanged"
                        Margin="0,0,0,12"/>


                    <!-- LIST / SELECTED DIVIDER -->
                    <Rectangle
                        Grid.Row="3"
                        Height="1"
                        Fill="#443A53"
                        Margin="0,0,0,12"/>


                    <!-- SELECTED COMPANY LABEL -->
                    <TextBlock
                        Grid.Row="4"
                        Text="Selected Company"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#B5B5BE"
                        Margin="0,0,0,6"/>


                    <!-- SELECTED COMPANY -->
                    <Border
                        Grid.Row="5"
                        Background="#292730"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,14">

                        <TextBlock
                            x:Name="SelectedCompanyText"
                            Text="No Company Selected"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </Border>


                    <!-- RELATIONSHIP TYPE -->
                    <StackPanel
                        Grid.Row="6"
                        Spacing="4"
                        Margin="0,0,0,12">

                        <TextBlock FontSize="14">

                            <Run Text="Relationship Type"/>

                            <Run
                                Text=" *"
                                Foreground="Red"/>

                        </TextBlock>

                        <ComboBox
                            x:Name="RelationshipTypeComboBox"
                            Style="{StaticResource NovaComboBoxStyle}"
                            HorizontalAlignment="Stretch">

                            <ComboBoxItem Content="Customer"/>
                            <ComboBoxItem Content="Vendor"/>
                            <ComboBoxItem Content="Both"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- COMPANY PART NUMBER + SAVE RELATION -->
                    <Grid
                        Grid.Row="7"
                        ColumnSpacing="10"
                        Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Company Part Number"
                                FontSize="14"
                                Foreground="#B5B5BE"/>

                            <TextBox
                                x:Name="CompanyPartNumberText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Save Relation"
                            VerticalAlignment="Bottom"
                            Padding="14,8"
                            Background="Transparent"
                            BorderBrush="#7659B0"
                            BorderThickness="1"
                            Foreground="#D8D0F0"
                            Click="SaveRelation_Click"/>

                    </Grid>


                    <!-- PRICE SECTION DIVIDER -->
                    <Rectangle
                        Grid.Row="8"
                        Height="1"
                        Fill="#443A53"
                        Margin="0,2,0,16"/>


                    <!-- PRICE + HISTORY -->
                    <StackPanel
                        Grid.Row="9"
                        Spacing="12">

                        <TextBlock
                            Text="Price &amp; History"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#D2C1FF"/>


                        <!-- LATEST PRICE -->
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="Latest Price"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"/>

                            <TextBlock
                                x:Name="LatestCostText"
                                Grid.Column="1"
                                Text="$0.00"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#C8B3FF"/>

                        </Grid>


                        <!-- PRICE HISTORY -->
                        <TextBlock
                            Text="Price History"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Margin="0,6,0,0"/>

                        <ListView
                            x:Name="PriceHistoryList"
                            MinHeight="90"
                            MaxHeight="180"
                            VerticalAlignment="Top"/>

                    </StackPanel>


                    <!-- FLEXIBLE EMPTY SPACE -->
                    <Grid Grid.Row="10"/>


                    <!-- ADD PRICE -->
                    <Button
                        Grid.Row="11"
                        Content="Add Price"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"
                        Padding="14,9"
                        Background="#7659B0"
                        Foreground="White"
                        Click="AddPriceEntry_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>