<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nova.Views.PartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nova.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#121217">

        <Grid  Margin="24,20,24,24">

            <!-- Define rows in main grid -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page title -->
            <TextBlock
                Grid.Row="0"
                Text="Parts"
                FontSize="32"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <!-- Search bar and new parts button-->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,12,0,20">

                <TextBox
                    PlaceholderText="Search parts..."
                    Width="380"
                    Style="{StaticResource NovaTextBoxStyle}"/>

                <Button
                    Content="New Part"
                    Background="Transparent"
                    BorderBrush="#6F5AA8"
                    BorderThickness="1"
                    Foreground="#D8D0F0"
                    Click="NewPart_Click"/>

            </StackPanel>

            <!-- Part details area -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Orientation="Vertical"
                Spacing="12"
                Margin="24,0,24,24">

                <!-- Columns -->
                <Grid ColumnSpacing="20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>



                    <!-- Left -->
                    <Border
                        Grid.Column="0"
                        Padding="20"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#6F5AA8"
                        Background="#1F1F24">

                        <StackPanel
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            Spacing="12">

                            <TextBlock
                                Text="Part Information"
                                FontSize="20"
                                Foreground="#B9A7FF"
                                FontWeight="SemiBold"/>

                            <Grid
                                RowSpacing="12"
                                ColumnSpacing="12">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Part Name -->
                                <StackPanel 
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="14">

                                        <Run Text="Part Name"/>
                                        <Run
                                            Text=" *"
                                            Foreground="Red"/>

                                    </TextBlock>

                                    <TextBox
                                        x:Name="PartNameText"
                                        Style="{StaticResource NovaTextBoxStyle}"/>

                                </StackPanel>

                                <!-- Primary Part Number -->
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="14">

                                        <Run Text="Primary Part Number"/>
                                        <Run
                                            Text=" *"
                                            Foreground="Red"/>

                                    </TextBlock>

                                    <TextBox 
                                        x:Name="PrimaryPartNumberText"
                                        Style="{StaticResource NovaTextBoxStyle}"/>


                                </StackPanel>

                                <!-- Unit Type -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="14">

                                        <Run Text="Unit Type"/>
                                        <Run
                                            Text=" *"
                                            Foreground="Red"/>

                                    </TextBlock>

                                    <TextBox
                                        x:Name="UnitTypeText"
                                        Style="{StaticResource NovaTextBoxStyle}"/>

                                </StackPanel>

                                <!-- Ship Weight -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="14">

                                        <Run Text="Ship Weight"/>
                                        <Run
                                            Text=" *"
                                            Foreground="Red"/>

                                    </TextBlock>

                                    <TextBox 
                                        x:Name="ShipWeightText"
                                        Style="{StaticResource NovaTextBoxStyle}"/>

                                </StackPanel>

                                <!-- Cubic Feet -->
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="14">

                                        <Run Text="Cubic Feet"/>
                                        <Run
                                            Text=" *"
                                            Foreground="Red"/>

                                    </TextBlock>

                                    <TextBox 
                                        x:Name="CubicFeetText"
                                        Style="{StaticResource NovaTextBoxStyle}"/>

                                </StackPanel>

                                <!-- Part Flags -->
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Part Flags"
                                        FontSize="14"/>

                                    <Border
                                        Background="#17171B"
                                        BorderBrush="#4E426F"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10">

                                        <StackPanel>

                                            <CheckBox
                                            x:Name="DrawingOnFileCheckBox"
                                            Content="Drawing on File"
                                            HorizontalAlignment="Left"/>

                                            <CheckBox
                                            x:Name="MoldAvailableCheckBox"
                                            Content="Mold Available"
                                            HorizontalAlignment="Left"/>


                                        </StackPanel>

                                    </Border>


                                </StackPanel>

                            </Grid>
                            <!-- Description -->
                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Description"
                                    FontSize="14"/>

                                <TextBox
                                    x:Name="DescriptionText"
                                    Style="{StaticResource NovaTextBoxStyle}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="70"/>

                            </StackPanel>

                            <!-- Notes -->
                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Notes"
                                    FontSize="14"/>

                                <TextBox
                                    x:Name="NotesText"
                                    Style="{StaticResource NovaTextBoxStyle}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="100"
                                    VerticalContentAlignment="Top"/>

                            </StackPanel>

                            <Button
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Content="Save Part"
                                Background="#6F5AA8"
                                Foreground="White"
                                Click="SavePart_Click"/>


                        </StackPanel>

                    </Border>

                    <!-- Right -->
                    <Border
                        Grid.Column="1"
                        Padding="16"
                        CornerRadius="10"
                        BorderThickness="1"
                        Background="#1B1B20"
                        BorderBrush="#4E426F">

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            Spacing="12">

                            <TextBlock
                                Text="Related Companies"
                                FontSize="20"
                                Foreground="#B9A7FF"
                                FontWeight="SemiBold"/>

                            <TextBox
                                x:Name="CompanySearchBar"
                                Style="{StaticResource NovaTextBoxStyle}"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Search companies..."/>

                            <!-- Company List -->
                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Company List"
                                    FontSize="18"/>

                                <ListView
                                    x:Name="CompanyList"
                                    MinHeight="140"
                                    MaxHeight="220"
                                    SelectionChanged="CompanyList_SelectionChanged"/>

                            </StackPanel>

                            <!-- Company Details -->
                            <StackPanel
                                Margin="0,8,0,0"
                                Spacing="10">

                                <TextBlock
                                    x:Name="SelectedCompanyText"
                                    Text="Selected Company"
                                    FontSize="18"/>

                                <!-- Customer Relationship -->
                                <StackPanel Spacing="4">

                                    <TextBlock
                                        FontSize="14">
                                        
                                        <Run Text="Relationship Type"/>
                                        <Run
                                            Text="*"
                                            Foreground="Red"/>

                                    </TextBlock>

                                    <ComboBox
                                        x:Name="RelationshipTypeComboBox"
                                        Style="{StaticResource NovaComboBoxStyle}">

                                        <ComboBoxItem Content="Customer"/>
                                        <ComboBoxItem Content="Vendor"/>
                                        <ComboBoxItem Content="Both"/>

                                    </ComboBox>

                                </StackPanel>

                                <!-- Company Part Number -->
                                <StackPanel 
                                    HorizontalAlignment="Left"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Company Part Number"
                                        FontSize="14"/>

                                    <TextBox
                                        x:Name="CompanyPartNumberText"
                                        Style="{StaticResource NovaTextBoxStyle}"
                                        HorizontalAlignment="Stretch"
                                        MaxWidth="200"/>

                                </StackPanel>

                                <Button
                                    Content="Save Relation"
                                    HorizontalAlignment="Left"
                                    Background="#6F5AA8"
                                    Foreground="White"
                                    Margin="0,0,0,8"
                                    Click="SaveRelation_Click"/>

                                <!-- Latest Cost and Price History -->
                                <StackPanel Spacing="4">

                                    <TextBlock
                                        Text="Latest Price"
                                        FontSize="14"/>

                                    <TextBlock
                                        x:Name="LatestCostText"
                                        Text="$0.00"/>

                                    <!-- Price History -->
                                    <TextBlock
                                        Text="Price History"
                                        FontSize="18"
                                        Margin="0,12,0,0"/>

                                    <ListView x:Name="PriceHistoryList">
                                    </ListView>

                                    <Button
                                        Content="Add Price"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderBrush="#6F5AA8"
                                        BorderThickness="1"
                                        Foreground="#D8D0F0"
                                        Click="AddPriceEntry_Click"/>

                                </StackPanel>

                            </StackPanel>


                        </StackPanel>
                        
                    </Border>

                </Grid>

            </StackPanel>

        </Grid>

    </Grid>

</Page>