<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Nova.Views.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nova.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="#121217"
        Padding="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Customers"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                <TextBlock
                    Text="Manage customer information, related parts, and pricing"
                    Margin="0,4,0,0"
                    Foreground="#9E9EA8"/>

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="New Customer"
                Padding="18,9"
                VerticalAlignment="Center"
                Background="#7659B0"
                Foreground="White"
                Click="NewCustomer_Click"/>

        </Grid>


        <!-- SEARCH -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBox
                    x:Name="CustomerSearchBar"
                    PlaceholderText="Search customers..."
                    Style="{StaticResource NovaTextBoxStyle}"
                    TextChanged="CustomerSearchBar_TextChanged"/>

                <ListView
                    x:Name="CustomerSearchResults"
                    MaxHeight="180"
                    Margin="0,4,0,0"
                    SelectionChanged="CustomerSearchResult_SelectionChanged"/>

            </StackPanel>

        </Grid>


        <!-- MAIN CONTENT -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>


            <!-- CUSTOMER INFORMATION -->
            <Border
                Grid.Column="0"
                Background="#1F1F24"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock
                        Grid.Row="0"
                        Text="Customer Information"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#C8B3FF"
                        Margin="0,0,0,16"/>


                    <!-- NAME + CONTACT -->
                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock FontSize="14">
                                <Run Text="Name"/>
                                <Run Text=" *"
                                     Foreground="Red"/>
                            </TextBlock>

                            <TextBox
                                x:Name="CustomerNameText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Contact Name"
                                FontSize="14"/>

                            <TextBox
                                x:Name="ContactNameText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- PHONE + EMAIL -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="12"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Phone"
                                FontSize="14"/>

                            <TextBox
                                x:Name="CustomerPhoneText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Email"
                                FontSize="14"/>

                            <TextBox
                                x:Name="CustomerEmailText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- ADDRESS -->
                    <StackPanel
                        Grid.Row="3"
                        Spacing="4"
                        Margin="0,0,0,12">

                        <TextBlock
                            Text="Address"
                            FontSize="14"/>

                        <TextBox
                            x:Name="CustomerAddressText"
                            Style="{StaticResource NovaTextBoxStyle}"/>

                    </StackPanel>


                    <Rectangle
                        Grid.Row="4"
                        Height="1"
                        Fill="#3C3548"
                        Margin="0,4,0,16"/>


                    <!-- NOTES -->
                    <StackPanel
                        Grid.Row="5"
                        Spacing="4">

                        <TextBlock
                            Text="Notes"
                            FontSize="14"/>

                        <TextBox
                            x:Name="CustomerNotesText"
                            Style="{StaticResource NovaTextBoxStyle}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="130"
                            VerticalContentAlignment="Top"/>

                    </StackPanel>


                    <Button
                        Grid.Row="6"
                        Content="Save Customer"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        Padding="18,9"
                        Background="#7659B0"
                        Foreground="White"
                        Click="SaveCustomer_Click"/>

                </Grid>

            </Border>


            <!-- RELATED PARTS -->
            <Border
                Grid.Column="1"
                Background="#211D29"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TITLE -->
                    <TextBlock
                        Grid.Row="0"
                        Text="Related Parts"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#D2C1FF"
                        Margin="0,0,0,14"/>


                    <!-- SEARCH -->
                    <TextBox
                        Grid.Row="1"
                        x:Name="CustomerPartSearchBar"
                        PlaceholderText="Search parts..."
                        Style="{StaticResource NovaTextBoxStyle}"
                        TextChanged="CustomerPartSearchBar_TextChanged"
                        Margin="0,0,0,8"/>


                    <!-- PART LIST -->
                    <ListView
                        Grid.Row="2"
                        x:Name="CustomerPartList"
                        MinHeight="130"
                        MaxHeight="200"
                        SelectionChanged="CustomerPartList_SelectionChanged"
                        Margin="0,0,0,12"/>


                    <!-- LIST / SELECTED DIVIDER -->
                    <Rectangle
                        Grid.Row="3"
                        Height="1"
                        Fill="#443A53"
                        Margin="0,0,0,12"/>


                    <!-- SELECTED PART LABEL -->
                    <TextBlock
                        Grid.Row="4"
                        Text="Selected Part"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#B5B5BE"
                        Margin="0,0,0,6"/>


                    <!-- SELECTED PART -->
                    <Border
                        Grid.Row="5"
                        Background="#292730"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,14">

                        <TextBlock
                            x:Name="SelectedCustomerPartText"
                            Text="No Selected Part"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </Border>


                    <!-- PART NUMBER -->
                    <Grid
                        Grid.Row="6"
                        ColumnSpacing="10"
                        Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Customer Part Number"
                                FontSize="14"
                                Foreground="#B5B5BE"/>

                            <TextBox
                                x:Name="CustomerPartNumberText"
                                Style="{StaticResource NovaTextBoxStyle}"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Save"
                            VerticalAlignment="Bottom"
                            Padding="14,8"
                            Background="Transparent"
                            BorderBrush="#7659B0"
                            BorderThickness="1"
                            Foreground="#D8D0F0"
                            Click="SaveCustomerPartNumber_Click"/>

                    </Grid>


                    <!-- PRICE SECTION DIVIDER -->
                    <Rectangle
                        Grid.Row="7"
                        Height="1"
                        Fill="#443A53"
                        Margin="0,2,0,16"/>


                    <!-- QUOTE + HISTORY -->
                    <StackPanel
                        Grid.Row="8"
                        Spacing="12">

                        <TextBlock
                            Text="Quote &amp; History"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#D2C1FF"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="Latest Quote"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"/>

                            <TextBlock
                                x:Name="LatestCustomerQuoteText"
                                Grid.Column="1"
                                Text="$0.00"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#C8B3FF"/>

                        </Grid>


                        <TextBlock
                            Text="Quote History"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Margin="0,6,0,0"/>

                        <ListView
                            x:Name="CustomerQuoteHistoryList"
                            MinHeight="90"
                            MaxHeight="180"
                            VerticalAlignment="Top"/>

                    </StackPanel>


                    <!-- FLEXIBLE SPACE -->
                    <Grid Grid.Row="9"/>


                    <!-- ADD QUOTE -->
                    <Button
                        Grid.Row="10"
                        Content="Add Quote"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"
                        Padding="14,9"
                        Background="#7659B0"
                        Foreground="White"
                        Click="AddCustomerQuote_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>